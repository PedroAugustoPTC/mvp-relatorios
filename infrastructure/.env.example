# Variaveis de ambiente do MVP Sistema de Relatorios para Escola de Musica.
#
# Copie este arquivo para `.env` (mesmo diretorio, `infrastructure/.env`) e preencha os valores
# reais antes de rodar `docker compose up`. O arquivo `.env` NUNCA deve ser commitado — garanta que
# `infrastructure/.env` esteja listado em .gitignore antes de inicializar o repositorio git deste
# projeto. Apenas este `.env.example`, com placeholders, deve ficar versionado.
#
# `docker-compose.yml` carrega este arquivo tanto via `env_file` (todas as chaves ficam
# disponiveis dentro do container do backend, resolvendo os placeholders `${...}` de
# `backend/src/main/resources/application.yml`) quanto via interpolacao direta no proprio
# `docker-compose.yml` (para os serviços postgres e n8n).

# ---------------------------------------------------------------------------
# Banco de dados (Postgres)
# ---------------------------------------------------------------------------
# Usados por docker-compose.yml para configurar o container do Postgres e para montar
# SPRING_DATASOURCE_URL/USERNAME/PASSWORD do backend (jdbc:postgresql://postgres:5432/${POSTGRES_DB}).
POSTGRES_DB=escola_musica
POSTGRES_USER=escola_musica
# Sem valor padrao: obrigatorio. Use uma senha forte e unica por ambiente.
POSTGRES_PASSWORD=change-me-to-a-strong-postgres-password

# ---------------------------------------------------------------------------
# Backend (Spring Boot) — seguranca (Principio V: segredos apenas via variavel de ambiente)
# ---------------------------------------------------------------------------
# Assinatura dos JWT de sessao do administrador (security.jwt.secret, T058). Sem valor padrao:
# obrigatorio. Use uma string aleatoria longa (32+ caracteres).
JWT_SECRET=change-me-to-a-long-random-string

# Chave de criptografia AES-GCM do CPF em repouso (security.cpf-encryption-key, T030). Sem valor
# padrao: obrigatorio. Idealmente uma chave AES-256 codificada em Base64 (32 bytes decodificados);
# um segredo textual comum tambem funciona (e derivado via SHA-256), mas uma chave Base64 dedicada
# e mais forte.
CPF_ENCRYPTION_KEY=change-me-to-a-base64-aes-256-key

# Token compartilhado que autentica as chamadas do workflow n8n aos endpoints /internal/v1/**
# (security.n8n-service-token, header X-N8N-Service-Token). Sem valor padrao: obrigatorio, e deve
# ser o MESMO valor usado abaixo em N8N_SERVICE_TOKEN (consumido pelos workflows n8n).
N8N_SERVICE_TOKEN=change-me-to-a-shared-secret-token

# Porta HTTP do backend dentro do container (server.port). Opcional — default 8080, ja mapeado
# pelo docker-compose.yml e pelo Dockerfile (EXPOSE 8080); so altere se souber o que esta fazendo.
#SERVER_PORT=8080

# Caminho de armazenamento dos PDFs gerados dentro do container (pdf.storage.path). Opcional —
# default /app/storage/pdfs, ja fixado no volume `pdf_storage` do docker-compose.yml.
#PDF_STORAGE_PATH=/app/storage/pdfs

# Nome da escola exibido nos relatorios/PDFs (escola.nome). Opcional — default "Escola de Música".
ESCOLA_NOME=Escola de Música

# ---------------------------------------------------------------------------
# Integracao com Telegram (bot usado pelos professores para registrar aulas)
# ---------------------------------------------------------------------------
# Token do bot do Telegram, obtido via @BotFather. Sem valor padrao: obrigatorio.
TELEGRAM_BOT_TOKEN=change-me-to-your-telegram-bot-token

# ---------------------------------------------------------------------------
# Provedor de Speech-to-Text (transcricao do audio das aulas)
# ---------------------------------------------------------------------------
# Chave de API do provedor de STT. Sem valor padrao: obrigatorio.
STT_API_KEY=change-me-to-your-stt-provider-api-key

# URL do endpoint de transcricao do provedor de STT. Opcional — default aponta para um provedor
# de exemplo; substitua pelo endpoint real do provedor escolhido.
#STT_PROVIDER_URL=https://stt-provider.example.com/v1/transcricoes

# ---------------------------------------------------------------------------
# Provedor de LLM (estruturacao dos relatorios de aula/semestrais)
# ---------------------------------------------------------------------------
# Chave de API do provedor de LLM. Sem valor padrao: obrigatorio.
LLM_API_KEY=change-me-to-your-llm-provider-api-key

# URL do endpoint de completions do provedor de LLM. Opcional — default aponta para um provedor
# de exemplo; substitua pelo endpoint real do provedor escolhido.
#LLM_PROVIDER_URL=https://llm-provider.example.com/v1/completions

# ---------------------------------------------------------------------------
# n8n (orquestracao dos fluxos de IA: transcricao, geracao de relatorios, Telegram)
# ---------------------------------------------------------------------------
# Credenciais de acesso a interface web do n8n (Basic Auth). Sem valor padrao: obrigatorio — o
# n8n fica exposto apenas em loopback (127.0.0.1:5678), mas ainda assim exige autenticacao.
N8N_BASIC_AUTH_USER=change-me-admin
N8N_BASIC_AUTH_PASSWORD=change-me-to-a-strong-n8n-password

# Host/protocolo/URL de webhook publicos do n8n. Opcionais — defaults adequados para
# desenvolvimento local (localhost/http). Ajuste em producao caso o n8n fique atras de um dominio
# ou proxy reverso proprio.
#N8N_HOST=localhost
#N8N_PROTOCOL=http
#N8N_WEBHOOK_URL=http://localhost:5678/

# Timezone usado pelo n8n para agendamentos/cron. Opcional — default America/Sao_Paulo.
#GENERIC_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Somente relevante FORA do docker-compose (ex.: rodando o backend standalone com `java -jar`,
# sem os serviços do compose). Quando rodando via `docker compose up`, o backend recebe
# SPRING_DATASOURCE_URL/USERNAME/PASSWORD montados a partir de POSTGRES_DB/POSTGRES_USER/
# POSTGRES_PASSWORD acima (ver docker-compose.yml), e estas tres variaveis abaixo sao ignoradas.
# ---------------------------------------------------------------------------
#DB_URL=jdbc:postgresql://localhost:5432/escola_musica
#DB_USERNAME=escola_musica
#DB_PASSWORD=change-me-to-a-strong-postgres-password
