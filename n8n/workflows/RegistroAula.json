{
  "name": "RegistroAula - Registrar aula por audio no Telegram (US1)",
  "active": false,
  "nodes": [
    {
      "id": "trigger-telegram",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram_bot_credentials",
          "name": "Telegram Bot - Escola de Musica"
        }
      }
    },
    {
      "id": "check-vinculacao",
      "name": "Professor Vinculado?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300],
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/telegram/{{$json.message.from.id}}/professor",
        "options": { "response": { "response": { "neverError": true } } },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "if-vinculado",
      "name": "If Vinculado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{$json.statusCode}}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "solicitar-codigo-vinculacao",
      "name": "Solicitar Codigo de Vinculacao",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 460],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Voce ainda nao esta vinculado. Envie o codigo de vinculacao recebido do administrador.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "listar-alunos",
      "name": "Listar Alunos do Professor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 220],
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/professores/{{$json.professorId}}/alunos",
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "menu-selecao-aluno",
      "name": "Exibir Menu de Selecao de Aluno",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 220],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Para qual aluno voce quer registrar a aula? Envie o audio da aula respondendo com o nome do aluno.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "wait-audio-message",
      "name": "Aguardar Audio da Aula",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [1100, 220],
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "baixar-audio-telegram",
      "name": "Baixar Audio (Telegram getFile)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1320, 220],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{$json.message.voice.file_id}}"
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "post-transcrever",
      "name": "POST /relatorios-aula/transcrever",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 220],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-aula/transcrever",
        "sendBinaryData": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "alunoId", "value": "={{$json.alunoId}}" },
            { "name": "professorId", "value": "={{$json.professorId}}" },
            { "name": "dataAula", "value": "={{$now.format('yyyy-MM-dd')}}" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "if-audio-processavel",
      "name": "If Audio Processavel",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 220],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{$json.statusCode}}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "informar-audio-invalido",
      "name": "Informar Audio Invalido",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1980, 380],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Nao consegui processar esse audio (corrompido, formato invalido ou silencio). Envie novamente, por favor.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "post-estruturar",
      "name": "POST /relatorios-aula/{aulaId}/estruturar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 140],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-aula/{{$json.aulaId}}/estruturar",
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "if-perguntas-pendentes",
      "name": "If Ha Perguntas Pendentes",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2200, 140],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{$json.perguntasPendentes.length}}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "perguntar-pendencia",
      "name": "Perguntar Pendencia ao Professor",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2420, 60],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "={{$json.perguntasPendentes[0]}}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "wait-resposta-pergunta",
      "name": "Aguardar Resposta do Professor",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [2640, 60],
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "post-responder-pergunta",
      "name": "POST /relatorios-aula/{relatorioId}/responder-pergunta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, 60],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-aula/{{$json.relatorioId}}/responder-pergunta",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "resposta", "value": "={{$json.message.text}}" }]
        },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "exibir-pdf",
      "name": "Exibir PDF de Conferencia",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2420, 220],
      "parameters": {
        "resource": "file",
        "operation": "sendDocument",
        "chatId": "={{$json.message.from.id}}",
        "binaryData": true,
        "additionalFields": {
          "caption": "Relatorio gerado (versao {{$json.versao}}). Responda 'aprovar' para confirmar ou descreva a alteracao desejada (ex.: 'mude a dificuldade para ritmo')."
        }
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "wait-decisao-professor",
      "name": "Aguardar Aprovar/Revisar",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [2640, 220],
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "if-aprovar-ou-revisar",
      "name": "If Aprovar",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2860, 220],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{$json.message.text}}",
              "rightValue": "aprovar",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "post-aprovar",
      "name": "POST /relatorios-aula/{relatorioId}/aprovar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3080, 140],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-aula/{{$json.relatorioId}}/aprovar",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "versaoConfirmada", "value": "={{$json.versao}}" }]
        },
        "options": { "response": { "response": { "neverError": true } } },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "post-revisar",
      "name": "POST /relatorios-aula/{relatorioId}/revisar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3080, 300],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-aula/{{$json.relatorioId}}/revisar",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "instrucao", "value": "={{$json.message.text}}" }]
        },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "confirmar-aprovado",
      "name": "Confirmar Aprovacao",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3300, 140],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Relatorio aprovado e salvo no historico do aluno.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Professor Vinculado?", "type": "main", "index": 0 }]]
    },
    "Professor Vinculado?": {
      "main": [[{ "node": "If Vinculado", "type": "main", "index": 0 }]]
    },
    "If Vinculado": {
      "main": [
        [{ "node": "Listar Alunos do Professor", "type": "main", "index": 0 }],
        [{ "node": "Solicitar Codigo de Vinculacao", "type": "main", "index": 0 }]
      ]
    },
    "Listar Alunos do Professor": {
      "main": [[{ "node": "Exibir Menu de Selecao de Aluno", "type": "main", "index": 0 }]]
    },
    "Exibir Menu de Selecao de Aluno": {
      "main": [[{ "node": "Aguardar Audio da Aula", "type": "main", "index": 0 }]]
    },
    "Aguardar Audio da Aula": {
      "main": [[{ "node": "Baixar Audio (Telegram getFile)", "type": "main", "index": 0 }]]
    },
    "Baixar Audio (Telegram getFile)": {
      "main": [[{ "node": "POST /relatorios-aula/transcrever", "type": "main", "index": 0 }]]
    },
    "POST /relatorios-aula/transcrever": {
      "main": [[{ "node": "If Audio Processavel", "type": "main", "index": 0 }]]
    },
    "If Audio Processavel": {
      "main": [
        [{ "node": "POST /relatorios-aula/{aulaId}/estruturar", "type": "main", "index": 0 }],
        [{ "node": "Informar Audio Invalido", "type": "main", "index": 0 }]
      ]
    },
    "POST /relatorios-aula/{aulaId}/estruturar": {
      "main": [[{ "node": "If Ha Perguntas Pendentes", "type": "main", "index": 0 }]]
    },
    "If Ha Perguntas Pendentes": {
      "main": [
        [{ "node": "Perguntar Pendencia ao Professor", "type": "main", "index": 0 }],
        [{ "node": "Exibir PDF de Conferencia", "type": "main", "index": 0 }]
      ]
    },
    "Perguntar Pendencia ao Professor": {
      "main": [[{ "node": "Aguardar Resposta do Professor", "type": "main", "index": 0 }]]
    },
    "Aguardar Resposta do Professor": {
      "main": [
        [{ "node": "POST /relatorios-aula/{relatorioId}/responder-pergunta", "type": "main", "index": 0 }]
      ]
    },
    "POST /relatorios-aula/{relatorioId}/responder-pergunta": {
      "main": [[{ "node": "Exibir PDF de Conferencia", "type": "main", "index": 0 }]]
    },
    "Exibir PDF de Conferencia": {
      "main": [[{ "node": "Aguardar Aprovar/Revisar", "type": "main", "index": 0 }]]
    },
    "Aguardar Aprovar/Revisar": {
      "main": [[{ "node": "If Aprovar", "type": "main", "index": 0 }]]
    },
    "If Aprovar": {
      "main": [
        [{ "node": "POST /relatorios-aula/{relatorioId}/aprovar", "type": "main", "index": 0 }],
        [{ "node": "POST /relatorios-aula/{relatorioId}/revisar", "type": "main", "index": 0 }]
      ]
    },
    "POST /relatorios-aula/{relatorioId}/aprovar": {
      "main": [[{ "node": "Confirmar Aprovacao", "type": "main", "index": 0 }]]
    },
    "POST /relatorios-aula/{relatorioId}/revisar": {
      "main": [[{ "node": "Exibir PDF de Conferencia", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "description": "US1 (T053): Telegram Trigger -> selecao de aluno -> recebimento de audio -> transcrever -> estruturar -> perguntas pendentes -> exibicao do PDF -> aprovar/revisar. Placeholders de credenciais/URLs devem ser configurados no ambiente n8n de destino (BACKEND_BASE_URL, N8N_SERVICE_TOKEN, credencial telegram_bot_credentials)."
  }
}
