{
  "name": "RelatorioSemestral - Gerar relatorio semestral consolidado (US3)",
  "active": false,
  "nodes": [
    {
      "id": "trigger-comando-relatorio-semestral",
      "name": "Telegram Trigger (/relatorio_semestral)",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram_bot_credentials",
          "name": "Telegram Bot - Escola de Musica"
        }
      }
    },
    {
      "id": "check-vinculacao",
      "name": "Professor Vinculado?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300],
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/telegram/{{$json.message.from.id}}/professor",
        "options": { "response": { "response": { "neverError": true } } },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "if-vinculado",
      "name": "If Vinculado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{$json.statusCode}}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "solicitar-codigo-vinculacao",
      "name": "Solicitar Codigo de Vinculacao",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 460],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Voce ainda nao esta vinculado. Envie o codigo de vinculacao recebido do administrador.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "listar-alunos",
      "name": "Listar Alunos do Professor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 220],
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/professores/{{$json.professorId}}/alunos",
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "menu-selecao-aluno",
      "name": "Exibir Menu de Selecao de Aluno",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 220],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Para qual aluno voce quer gerar o relatorio semestral? Responda com o nome do aluno.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "wait-selecao-aluno",
      "name": "Aguardar Selecao de Aluno",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [1100, 220],
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "get-semestres-disponiveis",
      "name": "GET /alunos/{alunoId}/semestres-disponiveis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 220],
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/alunos/{{$json.alunoId}}/semestres-disponiveis",
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "menu-selecao-semestre",
      "name": "Exibir Menu de Semestre",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1540, 220],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Selecione o semestre desejado (responda com a chave, ex.: 2026-1):\n={{$json.map(s => s.chave + ' - ' + s.rotulo).join('\\n')}}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "wait-selecao-semestre",
      "name": "Aguardar Selecao de Semestre",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [1760, 220],
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "post-contagem",
      "name": "POST /relatorios-semestrais/contagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 220],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-semestrais/contagem",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "alunoId", "value": "={{$json.alunoId}}" },
            { "name": "periodoChave", "value": "={{$json.message.text}}" }
          ]
        },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "if-tem-relatorios",
      "name": "If Ha Relatorios no Periodo",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2200, 220],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{$json.quantidadeRelatoriosAula}}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "informar-ausencia-de-dados",
      "name": "Informar Ausencia de Dados",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2420, 380],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Nao ha relatorios de aula aprovados nesse periodo para esse aluno. Escolha outro semestre ou registre aulas antes de gerar o relatorio semestral.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "informar-quantidade",
      "name": "Informar Quantidade Encontrada",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2420, 140],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Encontrei {{$json.quantidadeRelatoriosAula}} relatorio(s) de aula aprovados nesse periodo. Gerando o relatorio semestral consolidado...",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "post-gerar-relatorio-semestral",
      "name": "POST /relatorios-semestrais",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 140],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-semestrais",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "alunoId", "value": "={{$json.alunoId}}" },
            { "name": "professorId", "value": "={{$json.professorId}}" },
            { "name": "periodoChave", "value": "={{$json.periodoChave}}" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "exibir-pdf-semestral",
      "name": "Exibir PDF de Conferencia",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2860, 140],
      "parameters": {
        "resource": "file",
        "operation": "sendDocument",
        "chatId": "={{$json.message.from.id}}",
        "binaryData": true,
        "additionalFields": {
          "caption": "Relatorio semestral gerado (versao {{$json.versao}}), com base em {{$json.quantidadeRelatoriosAulaConsiderados}} relatorio(s) de aula. Responda 'aprovar' para confirmar ou descreva a alteracao desejada."
        }
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "wait-decisao-professor-semestral",
      "name": "Aguardar Aprovar/Revisar",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [3080, 140],
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    },
    {
      "id": "if-aprovar-ou-revisar-semestral",
      "name": "If Aprovar",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3300, 140],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{$json.message.text}}",
              "rightValue": "aprovar",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "post-aprovar-semestral",
      "name": "POST /relatorios-semestrais/{id}/aprovar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3520, 60],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-semestrais/{{$json.relatorioId}}/aprovar",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "versaoConfirmada", "value": "={{$json.versao}}" }]
        },
        "options": { "response": { "response": { "neverError": true } } },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "post-revisar-semestral",
      "name": "POST /relatorios-semestrais/{id}/revisar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3520, 220],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/internal/v1/relatorios-semestrais/{{$json.relatorioId}}/revisar",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "instrucao", "value": "={{$json.message.text}}" }]
        },
        "headerParametersUi": {
          "parameter": [
            { "name": "X-N8N-Service-Token", "value": "={{$env.N8N_SERVICE_TOKEN}}" }
          ]
        }
      }
    },
    {
      "id": "confirmar-aprovado-semestral",
      "name": "Confirmar Aprovacao",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3740, 60],
      "parameters": {
        "chatId": "={{$json.message.from.id}}",
        "text": "Relatorio semestral aprovado e salvo no historico do aluno.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram_bot_credentials", "name": "Telegram Bot - Escola de Musica" }
      }
    }
  ],
  "connections": {
    "Telegram Trigger (/relatorio_semestral)": {
      "main": [[{ "node": "Professor Vinculado?", "type": "main", "index": 0 }]]
    },
    "Professor Vinculado?": {
      "main": [[{ "node": "If Vinculado", "type": "main", "index": 0 }]]
    },
    "If Vinculado": {
      "main": [
        [{ "node": "Listar Alunos do Professor", "type": "main", "index": 0 }],
        [{ "node": "Solicitar Codigo de Vinculacao", "type": "main", "index": 0 }]
      ]
    },
    "Listar Alunos do Professor": {
      "main": [[{ "node": "Exibir Menu de Selecao de Aluno", "type": "main", "index": 0 }]]
    },
    "Exibir Menu de Selecao de Aluno": {
      "main": [[{ "node": "Aguardar Selecao de Aluno", "type": "main", "index": 0 }]]
    },
    "Aguardar Selecao de Aluno": {
      "main": [
        [{ "node": "GET /alunos/{alunoId}/semestres-disponiveis", "type": "main", "index": 0 }]
      ]
    },
    "GET /alunos/{alunoId}/semestres-disponiveis": {
      "main": [[{ "node": "Exibir Menu de Semestre", "type": "main", "index": 0 }]]
    },
    "Exibir Menu de Semestre": {
      "main": [[{ "node": "Aguardar Selecao de Semestre", "type": "main", "index": 0 }]]
    },
    "Aguardar Selecao de Semestre": {
      "main": [[{ "node": "POST /relatorios-semestrais/contagem", "type": "main", "index": 0 }]]
    },
    "POST /relatorios-semestrais/contagem": {
      "main": [[{ "node": "If Ha Relatorios no Periodo", "type": "main", "index": 0 }]]
    },
    "If Ha Relatorios no Periodo": {
      "main": [
        [{ "node": "Informar Quantidade Encontrada", "type": "main", "index": 0 }],
        [{ "node": "Informar Ausencia de Dados", "type": "main", "index": 0 }]
      ]
    },
    "Informar Quantidade Encontrada": {
      "main": [[{ "node": "POST /relatorios-semestrais", "type": "main", "index": 0 }]]
    },
    "POST /relatorios-semestrais": {
      "main": [[{ "node": "Exibir PDF de Conferencia", "type": "main", "index": 0 }]]
    },
    "Exibir PDF de Conferencia": {
      "main": [[{ "node": "Aguardar Aprovar/Revisar", "type": "main", "index": 0 }]]
    },
    "Aguardar Aprovar/Revisar": {
      "main": [[{ "node": "If Aprovar", "type": "main", "index": 0 }]]
    },
    "If Aprovar": {
      "main": [
        [{ "node": "POST /relatorios-semestrais/{id}/aprovar", "type": "main", "index": 0 }],
        [{ "node": "POST /relatorios-semestrais/{id}/revisar", "type": "main", "index": 0 }]
      ]
    },
    "POST /relatorios-semestrais/{id}/aprovar": {
      "main": [[{ "node": "Confirmar Aprovacao", "type": "main", "index": 0 }]]
    },
    "POST /relatorios-semestrais/{id}/revisar": {
      "main": [[{ "node": "Exibir PDF de Conferencia", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "description": "US3 (T083): comando /relatorio_semestral -> selecao de aluno -> menu de semestre (FR-011) -> contagem de relatorios de aula do periodo (FR-012) -> geracao/consolidacao via IA e PDF (FR-013/FR-013a), bloqueada quando a contagem e zero (FR-014) -> exibicao do PDF -> aprovar/revisar (FR-015/FR-016). Placeholders de credenciais/URLs devem ser configurados no ambiente n8n de destino (BACKEND_BASE_URL, N8N_SERVICE_TOKEN, credencial telegram_bot_credentials)."
  }
}
